            </classpath>
            <jvmarg value="-ea"/>
        </java>
        <java classname="lanmonitoringserver.service.Phase6SecurityValidationTest" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
                <pathelement path="${javac.classpath}"/>
            </classpath>
            <jvmarg value="-ea"/>
        </java>
    </target>

    <target name="test-phase7" depends="test-phase6" description="Run controlled Ansible integration tests">
        <java classname="lanmonitoringserver.service.AnsibleIntegrationTest" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
                <pathelement path="${javac.classpath}"/>
            </classpath>
            <jvmarg value="-ea"/>
        </java>
    </target>

    <target name="test-phase8" depends="test-phase7" description="Run wireless collection and distance-estimation tests">
        <java classname="lanmonitoringserver.monitor.wireless.WirelessCollectorTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/>
        </java>
        <java classname="lanmonitoringserver.service.WirelessPhase8Test" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/><jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="lanmonitoringserver.service.WirelessTransportIntegrationTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/>
        </java>
    </target>

    <target name="test-phase9" depends="test-phase8" description="Run final stability, resource and UI lifecycle checks">
        <java classname="lanmonitoringserver.service.ServerClientDistanceTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/><jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="lanmonitoringserver.ui.DistanceManagementPanelTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/><jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="lanmonitoringserver.service.Phase9StabilityTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/>
        </java>
        <java classname="lanmonitoringserver.ui.Phase9UiStabilityTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/><jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="lanmonitoringserver.monitor.wireless.MultiAccessPointScannerTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/>
        </java>
        <java classname="lanmonitoringserver.service.WifiFingerprintTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/><jvmarg value="-Djava.awt.headless=true"/>
        </java>
        <java classname="lanmonitoringserver.ui.WifiFingerprintPanelTest" fork="true" failonerror="true">
            <classpath><pathelement location="${build.classes.dir}"/><pathelement location="${build.test.classes.dir}"/><pathelement path="${javac.classpath}"/></classpath>
            <jvmarg value="-ea"/><jvmarg value="-Djava.awt.headless=true"/>
        </java>
    </target>

    <!-- Keep the conventional Ant entry point meaningful for this main-based test suite. -->
    <target name="test" depends="test-phase9" description="Run all Phase 1-9 regression tests"/>

    <!-- Clean release gate: tests must pass before NetBeans/CopyLibs creates the distribution. -->
    <target name="release-phase5" depends="clean,test-phase5,jar"
            description="Clean, test, and package the Phase 5 distribution"/>

    <target name="release-phase6" depends="clean,test-phase6,jar"
            description="Clean, test, and package the Phase 6 distribution"/>

    <target name="release-phase7" depends="clean,test-phase7,jar"
            description="Clean, test, and package the Phase 7 distribution"/>

    <target name="release-phase8" depends="clean,test-phase8,jar"
            description="Clean, test, and package the Phase 8 distribution"/>

    <target name="release-phase9" depends="clean,test-phase9,jar"
            description="Clean, test, and package the final Phase 9 distribution"/>

    <!-- Ship only reviewed automation assets; never copy vault/password/runtime files into dist. -->
    <target name="-post-jar">
        <copy todir="${dist.dir}/ansible">
            <fileset dir="ansible">
                <include name="ansible.cfg"/>
                <include name="playbooks/*.yml"/>
                <include name="collections/requirements.yml"/>
                <include name="config/managed-hosts.example.json"/>
            </fileset>
        </copy>
        <copy todir="${dist.dir}/scripts">
            <fileset dir="scripts">
                <include name="run-server.bat"/>
                <include name="run-client.bat"/>
                <include name="run-server.sh"/>
                <include name="run-client.sh"/>
                <include name="setup-tls-windows.ps1"/>
                <include name="run-server-tls.ps1"/>
                <include name="run-client-tls.ps1"/>
            </fileset>
        </copy>
        <copy todir="${dist.dir}/config">
            <fileset dir="config">
                <include name="runtime.example.env"/>
            </fileset>
        </copy>
        <copy file="README.md" todir="${dist.dir}"/>
        <copy file="THIRD_PARTY_NOTICES.md" todir="${dist.dir}"/>
        <copy todir="${dist.dir}/docs">
            <fileset dir="docs">
                <include name="README.md"/>
                <include name="PROJECT_OVERVIEW.md"/>
                <include name="ARCHITECTURE.md"/>
                <include name="PROTOCOL.md"/>
                <include name="FEATURES.md"/>
                <include name="INSTALLATION.md"/>
                <include name="DEMO_GUIDE.md"/>
                <include name="TEST_RESULTS.md"/>
                <include name="LIMITATIONS_AND_FUTURE_WORK.md"/>
                <include name="PHASE9_MULTI_DEVICE_CHECKLIST.md"/>
                <include name="WINDOWS_WIRELESS_DIAGNOSTICS.md"/>
                <include name="SERVER_CLIENT_DISTANCE_DESIGN.md"/>
                <include name="SERVER_CLIENT_DISTANCE_TEST_CHECKLIST.md"/>
                <include name="PHASE7_ANSIBLE_SETUP.md"/>
                <include name="PHASE7_TEST_CHECKLIST.md"/>
                <include name="PHASE8_TECHNICAL_REPORT.md"/>
                <include name="PHASE8_WIFI_TEST_CHECKLIST.md"/>
                <include name="WIFI_FINGERPRINTING_GUIDE.md"/>
                <include name="WIFI_FINGERPRINTING_FIELD_TEST_CHECKLIST.md"/>
                <include name="PHASE6_GUI_TEST_CHECKLIST.md"/>
                <include name="PHASE5_GUI_TEST_CHECKLIST.md"/>
            </fileset>
        </copy>
    </target>
</project>
