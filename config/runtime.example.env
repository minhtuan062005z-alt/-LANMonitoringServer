# Example only. The launch scripts do not auto-load this file.
# Copy values into the LANMONITORING_JAVA_OPTS environment variable for your machine.
# Never commit passwords, private keys, vault files, or real infrastructure addresses.

LANMONITORING_JAVA_OPTS="-Dlanmonitoring.telemetry.interval.ms=1000 -Dlanmonitoring.wifi.interval.ms=2000 -Dlanmonitoring.fingerprint.interval.ms=10000 -Dlanmonitoring.fingerprint.requireTls=true"

# TLS example: set actual paths/passwords only in the process environment or a protected local launcher.
# -Dlanmonitoring.tls.keyStore=C:\protected\server.p12
# -Dlanmonitoring.tls.trustStore=C:\protected\truststore.p12
# -Dlanmonitoring.tls.serverIdentity=lanmonitoring-server.local
# Password properties are intentionally omitted from this tracked example.
# Recommended Windows path: use scripts/setup-tls-windows.ps1 once, then
# scripts/run-server-tls.ps1 and scripts/run-client-tls.ps1. They prompt for
# the password and expose it only to the child Java process.
